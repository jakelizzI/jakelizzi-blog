---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { articles as articlesTable } from "../../db/schema";
import { eq } from "drizzle-orm";
import { marked } from "marked";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const db = Astro.locals.db;
const [article] = await db.select().from(articlesTable).where(eq(articlesTable.slug, slug));

if (!article) {
  return Astro.redirect('/404');
}

const htmlContent = await marked.parse(article.content);
---

<ArticleLayout
  title={article.title}
  description={article.description}
  date={new Date(article.date)}
  category={article.category}
  readTime={article.readTime}
>
  <div class="prose" set:html={htmlContent} />
</ArticleLayout>
