---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
---

<BaseLayout title="STORIES - ブログホーム">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">読みやすさを<br />追求したブログ</h1>
      <p class="hero-description">
        シンプルで美しいタイポグラフィが、あなたの思考を深める読書体験を提供します
      </p>
    </div>
  </section>

  <!-- Articles Section -->
  <section class="articles">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title">最新の記事</h2>
        <div class="section-line"></div>
      </header>
      
      <div class="articles-grid">
        <ArticleCard
          title="タイポグラフィの力：読みやすさがもたらす深い理解"
          excerpt="美しいタイポグラフィは単なる装飾ではありません。適切なフォント選択、行間、文字間隔は、読者の理解を深め、コンテンツへの没入を促進します。"
          date="2026年1月28日"
          readTime="6分で読めます"
          category="デザイン"
          categoryVariant="blue"
          href="/articles/typography"
        />
        <ArticleCard
          title="余白の美学：ミニマルデザインが生む集中力"
          excerpt="情報過多の時代において、余白は読者の集中力を保つ重要な要素です。過度な装飾を排除し、本質的なコンテンツに焦点を当てることで、読者はより深くメッセージを受け取ることができます。"
          date="2026年1月26日"
          readTime="4分で読めます"
          category="執筆"
          categoryVariant="purple"
          href="/articles/whitespace"
        />
        <ArticleCard
          title="色彩心理学とモノクロームデザイン"
          excerpt="白黒のデザインは、色の制約がありながらも、コントラストとタイポグラフィの力で強力なメッセージを伝えることができます。"
          date="2026年1月25日"
          readTime="6分で読めます"
          category="デザイン"
          categoryVariant="blue"
          href="/articles/monochrome"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    background: var(--gradient-hero);
    padding: 80px 0 64px;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--text-7xl);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -2px;
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: var(--gap-md);
  }

  .hero-description {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 600px;
  }

  /* Articles Section */
  .articles {
    background: var(--bg-white);
    padding: var(--gap-3xl) 0 var(--gap-4xl);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    margin-bottom: var(--gap-xl);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.5px;
    color: var(--text-primary);
    margin: 0;
  }

  .section-line {
    width: 100%;
    height: 1px;
    background: #E2E8F0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--gap-lg);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero {
      padding: 48px 0 40px;
    }

    .hero-title {
      font-size: var(--text-6xl);
    }

    .hero-description {
      font-size: var(--text-base);
    }

    .articles {
      padding: var(--gap-xl) 0 var(--gap-2xl);
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
