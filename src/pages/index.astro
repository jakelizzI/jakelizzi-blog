---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";

// Get all articles and sort by date (newest first)
const articles = (await getCollection("articles")).sort(
  (a: CollectionEntry<"articles">, b: CollectionEntry<"articles">) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="jakelizzi - 気ままなブログ">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">怠惰なエンジニアの気ままなブログ</h1>
      <p class="hero-description">jakelizziが気ままにノンジャンルで色々書いたりしようと思っています</p>
    </div>
  </section>

  <!-- Articles Section -->
  <section class="articles">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title">最新の記事</h2>
        <div class="section-line"></div>
      </header>

      <div class="articles-grid">
        {
          /* prettier-ignore */
          articles.map((article: CollectionEntry< "articles">) => (
          <ArticleCard title={article.data.title} excerpt={article.data.description} date={article.data.date.toLocaleDateString("ja-JP", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })} readTime={article.data.readTime} category={article.data.category} categoryVariant={article.data.category === "デザイン" ? "blue" : "purple"} href={`/articles/${article.slug}`} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    background: var(--gradient-hero);
    padding: 80px 0 64px;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--text-7xl);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -2px;
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: var(--gap-md);
  }

  .hero-description {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 600px;
  }

  /* Articles Section */
  .articles {
    background: var(--bg-white);
    padding: var(--gap-3xl) 0 var(--gap-4xl);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    margin-bottom: var(--gap-xl);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.5px;
    color: var(--text-primary);
    margin: 0;
  }

  .section-line {
    width: 100%;
    height: 1px;
    background: #e2e8f0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--gap-lg);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero {
      padding: 48px 0 40px;
    }

    .hero-title {
      font-size: var(--text-6xl);
    }

    .hero-description {
      font-size: var(--text-base);
    }

    .articles {
      padding: var(--gap-xl) 0 var(--gap-2xl);
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
