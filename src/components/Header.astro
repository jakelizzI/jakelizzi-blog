---
// Desktop: 80px height, white background with shadow
// Mobile: 60px height
// Logo: "jakelizzi" in Playfair italic
---

<header>
  <div class="container">
    <a href="/" class="logo">
      <div class="title-content">
        <img class="title_logo" src="/favicon.svg?v=2" alt="logo" />
        <h1 class="title">jakelizzi's blog</h1>
      </div>
    </a>
  </div>
</header>

<style>
  header {
    width: 100%;
    background: var(--bg-white);
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .container {
    display: flex;
    align-items: center;
    height: 80px;
    padding: 0 var(--gap-3xl);
  }

  .logo {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 600;
    font-style: italic;
    color: var(--text-primary);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .logo:hover {
    opacity: 0.7;
  }

  .title-content {
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    align-items: baseline;
  }

  .title {
    font-size: var(--text-2xl);
    font-weight: 600;
    font-style: italic;
    color: var(--text-primary);
    margin-bottom: 0px;
    margin-left: 20px;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .container {
      height: 60px;
      padding: 0 var(--gap-lg);
    }

    .logo {
      font-size: var(--text-lg);
    }
  }
</style>
