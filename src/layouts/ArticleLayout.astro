---
// Article detail layout with hero section and content area
// Based on design.pen Article Detail page

import BaseLayout from "./BaseLayout.astro";
import Badge from "../components/Badge.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  readTime: string;
}

const { title, description, date, category, readTime } = Astro.props;

const categoryVariant = category === "デザイン" ? "blue" : "purple";
const formattedDate = date.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${title} - jakelizzi's blog`} description={description}>
  <!-- Article Hero Section -->
  <section class="article-hero">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/" class="breadcrumb-link">ホーム</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{category}</span>
      </nav>

      <!-- Article Meta -->
      <div class="article-meta">
        <span class="meta-date">{formattedDate}</span>
        <span class="meta-sep">/</span>
        <span class="meta-read">{readTime}</span>
        <Badge category={category} variant={categoryVariant} />
      </div>

      <!-- Article Title -->
      <h1 class="article-title">{title}</h1>
    </div>
  </section>

  <!-- Article Content -->
  <article class="article-content">
    <div class="container-narrow">
      <div class="intro">
        {description}
      </div>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* Article Hero Section */
  .article-hero {
    background: var(--bg-primary);
    padding: 80px 0 64px;
  }

  .article-hero .container {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.5px;
  }

  .breadcrumb-link {
    color: #888888;
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    opacity: 0.7;
  }

  .breadcrumb-sep {
    color: #cccccc;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .breadcrumb-current {
    color: #888888;
  }

  /* Article Meta */
  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
  }

  .meta-date,
  .meta-read {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.5px;
    color: #888888;
  }

  .meta-sep {
    color: #cccccc;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  /* Article Title */
  .article-title {
    font-family: var(--font-serif);
    font-size: var(--text-7xl);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -2px;
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0;
    max-width: 900px;
  }

  /* Article Content */
  .article-content {
    background: var(--bg-white);
    padding: 64px 0 80px;
  }

  .container-narrow {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--gap-3xl);
  }

  .intro {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: var(--gap-xl);
    white-space: pre-wrap;
  }

  /* Article Content Typography */
  .article-content :global(h2) {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -1px;
    line-height: 1.3;
    color: var(--text-primary);
    margin-top: var(--gap-2xl);
    margin-bottom: var(--gap-lg);
    position: relative;
  }

  .article-content :global(h2::before) {
    content: "";
    position: absolute;
    top: -12px;
    left: 0;
    width: 48px;
    height: 4px;
    background: var(--gradient-blue);
    border-radius: var(--radius-sm);
  }

  .article-content :global(h3) {
    font-family: var(--font-sans);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.3px;
    line-height: 1.4;
    color: var(--text-primary);
    margin-top: var(--gap-xl);
    margin-bottom: var(--gap-md);
  }

  .article-content :global(p) {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    line-height: 1.8;
    color: var(--text-body);
    margin-bottom: var(--gap-xl);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    line-height: 1.8;
    color: var(--text-body);
    margin-bottom: var(--gap-xl);
    padding-left: var(--gap-xl);
  }

  .article-content :global(li) {
    margin-bottom: var(--gap-sm);
  }

  .article-content :global(blockquote) {
    background: var(--bg-quote);
    padding: var(--gap-xl) var(--gap-2xl);
    border-radius: var(--radius-md);
    margin: var(--gap-2xl) 0;
  }

  .article-content :global(blockquote p) {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-style: italic;
    line-height: 1.5;
    color: var(--text-primary);
    margin-bottom: var(--gap-md);
  }

  .article-content :global(blockquote p:last-child) {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-style: normal;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .article-hero {
      padding: 40px 0 32px;
    }

    .article-title {
      font-size: var(--text-5xl);
      letter-spacing: -1.5px;
    }

    .article-content {
      padding: 32px 0 48px;
    }

    .container-narrow {
      padding: 0 var(--gap-lg);
    }

    .intro {
      font-size: var(--text-lg);
    }

    .article-content :global(h2) {
      font-size: var(--text-4xl);
      letter-spacing: -0.8px;
    }

    .article-content :global(h3) {
      font-size: var(--text-xl);
    }

    .article-content :global(p) {
      font-size: var(--text-md);
    }

    .article-content :global(blockquote) {
      padding: var(--gap-lg) var(--gap-xl);
    }

    .article-content :global(blockquote p) {
      font-size: var(--text-xl);
    }
  }
</style>
