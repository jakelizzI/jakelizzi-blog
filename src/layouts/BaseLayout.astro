---
import "../styles/global.css";
import "highlight.js/styles/atom-one-dark.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { env } from "cloudflare:workers";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "jakelizzi's blog",
  description = "jakelizziが気ままにノンジャンルで色々書いたりしようと思っています",
} = Astro.props;

function isValidGaId(id: string | undefined | null): boolean {
  if (!id) return false;
  return /^G-[A-Z0-9]+$/i.test(id) || /^UA-\d+-\d+$/i.test(id);
}

// Cloudflare Workersのruntime envからPUBLIC_GA_IDを取得（ローカル開発時はprocess.envやimport.meta.envにフォールバック）
const rawGaId =
  env.PUBLIC_GA_ID ??
  (typeof process !== "undefined" ? process.env.PUBLIC_GA_ID : undefined) ??
  import.meta.env.PUBLIC_GA_ID;

const gaId = isValidGaId(rawGaId) ? rawGaId : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    {/* Google Analytics (PUBLIC_GA_ID が設定されている場合のみ出力) */}
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script
            is:inline
            set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${gaId}');
        `}
          />
        </>
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }
</style>
